# =============================================================================
# Dockerfile — FastAPI API (Multi-stage Build para optimizar tamaño)
# =============================================================================
# Usa virtualenv en /opt/venv para evitar problemas de permisos entre el
# builder (root) y el runtime (usuario no-root 'rag').
# =============================================================================
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Virtualenv en ruta accesible por cualquier usuario (no bajo /root)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml ./
COPY sdk/python ./sdk/python

RUN pip install --no-cache-dir \
    fastapi>=0.115.0 \
    uvicorn[standard]>=0.30.0 \
    pydantic>=2.0.0 \
    pydantic-settings>=2.0.0 \
    sqlalchemy[asyncio]>=2.0.30 \
    asyncpg>=0.29.0 \
    psycopg2-binary>=2.9.0 \
    redis[hiredis]>=5.0.0 \
    litellm>=1.40.0 \
    qdrant-client>=1.9.0 \
    structlog>=24.0.0 \
    prometheus-fastapi-instrumentator>=7.0.0 \
    prometheus-client>=0.20.0 \
    httpx>=0.27.0 \
    alembic>=1.14.0 \
    sqlglot>=26.0.0 \
    hvac>=2.0.0 \
    opentelemetry-api>=1.30.0 \
    opentelemetry-sdk>=1.30.0 \
    opentelemetry-exporter-otlp>=1.30.0 \
    opentelemetry-instrumentation-fastapi>=0.51b0 \
    cryptography>=42.0.0 \
    bcrypt>=4.1.0 \
    markitdown[pdf,docx]>=0.1.3 \
    openpyxl>=3.1.0 \
    boto3>=1.34.0 \
    python-multipart>=0.0.9 \
    mcp>=2.0 \
    && pip install --no-cache-dir ./sdk/python

# =============================================================================
# Stage final — Imagen de producción minimalista
# =============================================================================
FROM python:3.11-slim AS final

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copia el virtualenv completo (el usuario rag puede leer /opt/venv)
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Copia el código fuente y archivos de proyecto
COPY src/ ./src/
COPY pyproject.toml ./
COPY alembic.ini ./
COPY worker_entry.py ./

# Usuario no-root por seguridad (CISO requirement)
# /app/uploads debe existir ANTES del montaje del volumen para que el
# named volume herede el ownership del usuario rag.
RUN groupadd -r rag && useradd -r -g rag -d /app -s /sbin/nologin rag && \
    mkdir -p /app/uploads && \
    chown -R rag:rag /app /opt/venv

USER rag

# Health check del contenedor
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
