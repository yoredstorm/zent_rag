# =============================================================================
# Dockerfile — FastAPI API (Multi-stage Build para optimizar tamaño)
# =============================================================================
# Usa virtualenv en /opt/venv para evitar problemas de permisos entre el
# builder (root) y el runtime (usuario no-root 'rag').
# =============================================================================
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Toolchain reproducible: mismas versiones exactas que CI/tests (uv.lock).
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /bin/

# Virtualenv en ruta accesible por cualquier usuario (no bajo /root)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
COPY sdk/python ./sdk/python

# Deps de producción desde el lock (frozen). El proyecto en sí no se instala:
# el runtime copia el código y usa PYTHONPATH (mismo contrato que CI).
RUN uv sync --frozen --extra prod --no-install-project \
    && pip install --no-cache-dir ./sdk/python
# JEV SDK opcional: el adapter HTTP (src/decision/providers/jev.py) ya usa
# httpx, instalado arriba. Para el cliente oficial, agregar a la lista
# anterior: typesafe-sdk>=0.1.0

# =============================================================================
# Stage runtime — base compartida API/worker (sin JVM)
# =============================================================================
FROM python:3.11-slim AS runtime

# SHA del commit que construyó la imagen. Vacío => unknown, no un git viejo.
ARG GIT_SHA=
ARG BUILD_TIMESTAMP=
ARG IMAGE_ID=
ENV RAG_GIT_SHA=${GIT_SHA} \
    RAG_BUILD_TIMESTAMP=${BUILD_TIMESTAMP} \
    RAG_IMAGE_ID=${IMAGE_ID} \
    RAG_SERVICE_NAME=api \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copia el virtualenv completo (el usuario rag puede leer /opt/venv)
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Copia el código fuente y archivos de proyecto
COPY src/ ./src/
COPY pyproject.toml ./
COPY alembic.ini ./
COPY worker_entry.py ./

# Usuario no-root por seguridad (CISO requirement)
# /app/uploads debe existir ANTES del montaje del volumen para que el
# named volume herede el ownership del usuario rag.
RUN groupadd -r rag && useradd -r -g rag -d /app -s /sbin/nologin rag && \
    mkdir -p /app/uploads && \
    chown -R rag:rag /app /opt/venv

USER rag

# Health check del contenedor
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --no-access-log"]

# =============================================================================
# Worker de ingesta con JVM — OpenDataLoader PDF (Fase 1).
# La JVM solo entra en este target; la API default sigue minimalista.
# Compose: servicio ingestion-worker con build.target=worker.
# =============================================================================
FROM runtime AS worker

ENV RAG_SERVICE_NAME=ingestion-worker

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*
RUN /opt/venv/bin/pip install --no-cache-dir "opendataloader-pdf>=2.5.12,<3.0" \
    && chown -R rag:rag /opt/venv
USER rag

# JAVA_HOME para ODL_JAVA_HOME / diagnóstico; `java` también queda en PATH.
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# =============================================================================
# Stage API (sin JVM): sólo para despliegues que no parseen PDF. El parser PDF
# productivo es OpenDataLoader: docker-compose usa `target: worker` también para
# la API porque la ingesta in-process necesita JVM.
# =============================================================================
FROM runtime AS api
