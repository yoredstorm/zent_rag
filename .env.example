# =============================================================================
# .env.example — Variables de entorno para RAG-as-a-Service Platform
# =============================================================================
# Copia este archivo a .env y rellena los valores. NUNCA comitees .env al repo.
# En producción, los secretos deben ir en HashiCorp Vault, no en variables de entorno.

# --- Entorno ---
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_API_PORT=8000
PORTAL_PORT=8080
RAG_CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- PostgreSQL ---
RAG_POSTGRES_HOST=localhost
RAG_POSTGRES_PORT=5432
RAG_POSTGRES_USER=rag_user
RAG_POSTGRES_PASSWORD=changeme_in_production
RAG_POSTGRES_DB=rag_platform

# --- Qdrant (Vector Store) ---
RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
# RAG_QDRANT_API_KEY=
RAG_QDRANT_GRPC_PORT=6334
RAG_QDRANT_TIMEOUT_SECONDS=60
RAG_QDRANT_UPSERT_CONCURRENCY=2

# --- Redis ---
RAG_REDIS_URL=redis://localhost:6379/0

# --- LiteLLM (LLM Proxy) ---
# RAG_LITELLM_API_BASE=https://api.novita.ai/openai
# RAG_LITELLM_API_KEY=sk-...
RAG_LITELLM_DEFAULT_MODEL=gpt-4o-mini
RAG_LITELLM_TIMEOUT_SECONDS=60

# --- Embeddings ---
# Cloud (rápido, recomendado sin GPU / BD masiva). Usa LITELLM_API_BASE + KEY:
RAG_EMBEDDING_MODEL=openai/baai/bge-m3
# Local CPU vía Ollama (lento en >10K filas). Si usas esto, el ingest se autolimita a concurrency=1:
# RAG_EMBEDDING_MODEL=ollama/bge-m3
RAG_VECTOR_DIMENSION=1024

# --- Ingestion performance ---
RAG_INGEST_EMBED_BATCH_SIZE=64
RAG_INGEST_EMBED_CONCURRENCY=8
RAG_INGEST_TABLE_CONCURRENCY=3
RAG_INGEST_UPSERT_BATCH_SIZE=100
RAG_INGEST_PAGE_SIZE=1000
# Tablas a omitir (comma-separated). sales/reviews/inventory = seed masivo poco útil para RAG demo.
# Vaciar para sync completo. Si Novita rate-limita, baja concurrency.
RAG_INGEST_SKIP_TABLES=sales,product_reviews,inventory
# Tope de filas por tabla (0 = sin tope).
RAG_INGEST_MAX_ROWS_PER_TABLE=0

# --- Portal auth (email/password + AES-256-GCM session) ---
# REQUIRED. 32-byte key as hex (64 hex chars). Generate: openssl rand -hex 32
# Production refuses the insecure development default below.
RAG_PORTAL_SESSION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
RAG_PORTAL_SESSION_TTL_HOURS=24
RAG_AUTH_LOGIN_MAX_ATTEMPTS=5
RAG_AUTH_LOGIN_WINDOW_SECONDS=900
# Dev seed login (ENVIRONMENT=development only)
RAG_PORTAL_DEV_EMAIL=demo@zenttech.com
RAG_PORTAL_DEV_PASSWORD=demo-password-change-me

# --- RAG ---
RAG_RAG_TOP_K=200
RAG_RAG_SCORE_THRESHOLD=0.0
RAG_RAG_CONVERSATION_TTL_SECONDS=3600
RAG_RAG_SQL_EXPERT_ENABLED=false
RAG_RAG_SQL_TIMEOUT_SECONDS=5
RAG_RAG_MAX_CONTEXT_TOKENS=32000
RAG_RAG_RERANK_ENABLED=false
RAG_RAG_RERANK_TOP_N=20
RAG_RAG_ADMIN_ENABLED=true
RAG_RAG_CHUNK_MAX_CHARS=1200
RAG_RAG_CHUNK_OVERLAP=150
RAG_RAG_LAZY_INGESTION_ENABLED=false
RAG_RAG_LAZY_INGEST_MAX_ROWS_PER_TABLE=25
RAG_RAG_LAZY_INGEST_MAX_TABLES=5
RAG_RAG_LAZY_INGEST_TIMEOUT_SECONDS=4
RAG_RAG_LAZY_INGEST_PROMOTE_THRESHOLD=10

# --- Billing ---
RAG_BILLING_ENABLED=true
RAG_BILLING_TRIAL_REQUESTS=500
RAG_BILLING_TRIAL_DAYS=30

# --- Background ingestion worker ---
RAG_RAG_BACKGROUND_INGESTION=false

# --- Vault (futuro) ---
# RAG_VAULT_ADDR=https://vault.corp.example.com
# RAG_VAULT_TOKEN=

# --- Rate Limiting ---
RAG_RATE_LIMIT_PER_MINUTE=60
RAG_RATE_LIMIT_PER_TENANT_MINUTE=600

# --- Grafana (docker-compose only; declared in Settings for extra=forbid) ---
# With env_prefix RAG_, app Settings reads RAG_GRAFANA_* if set.
# Compose also substitutes GRAFANA_* below for the grafana service.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
