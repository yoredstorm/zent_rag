meta {
  name: RAG Query (Bearer Token)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/rag/query
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{dev_token}}
}

body:json {
  {
    "query": "cual fue la ultima venta",
    "role": "admin"
  }
}
