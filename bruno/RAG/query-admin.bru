meta {
  name: RAG Query (admin)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/rag/query
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tenant-Id: {{tenant_id}}
  X-User-Id: {{user_id}}
  X-User-Role: {{role}}
}

body:json {
  {
    "query": "cual fue la ultima venta",
    "role": "admin",
    "top_k": 200,
    "temperature": 0.3,
    "max_tokens": 2048
  }
}
