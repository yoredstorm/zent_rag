        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"rag-api\"}[5m]))",
          "legendFormat": "P99 {{handler}}",
          "refId": "C"
        }
      ],
      "title": "Latencia — Percentiles (P50/P95/P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 50 }] },
          "unit": "short"
